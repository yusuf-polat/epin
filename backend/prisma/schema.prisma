datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  DESTEK
  ADMIN
}

enum SellerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PinStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  HELD_IN_ESCROW
  RELEASED_TO_SELLER
  DISPUTED
  REFUNDED_TO_BUYER
  REPLACED
}

enum DisputeReason {
  INVALID_CODE
  ALREADY_USED
  WRONG_PRODUCT
  OTHER
}

enum DisputeStatus {
  WAITING_SELLER
  SELLER_APPROVED
  WAITING_SUPPORT
  RESOLVED_BUYER
  RESOLVED_SELLER
  CANCELLED
}

enum DeliveryType {
  INSTANT
  MANUAL
  API
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum PaymentMethod {
  WALLET
  CREDIT_CARD
  HAVALE_EFT
  CRYPTO
}

/// Bakiye yükleme sağlayıcıları (admin panelinden yönetilir)
enum PaymentProvider {
  BANK_TRANSFER
  CRYPTO_MANUAL
  STRIPE
  PAYTR
  IYZICO
  NOWPAYMENTS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum ComplaintTarget {
  PRODUCT
  STORE
  REVIEW
}

enum ComplaintStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER
  DISPUTE
  SELLER_REQUEST
  PRODUCT
  SYSTEM
  WALLET
  SUPPORT
  MESSAGE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  SALE_RELEASE
  REFUND
  ADMIN_ADJUSTMENT
  WITHDRAWAL
  WITHDRAWAL_REFUND
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  password         String
  role             Role      @default(USER)
  walletBalance    Decimal   @default(0.00) @db.Decimal(12, 2)
  avatarUrl        String?
  phone            String?
  canSell          Boolean   @default(false)
  sellerApprovedAt DateTime?
  isBanned         Boolean   @default(false)
  bannedAt         DateTime?
  banReason        String?
  // Bu tarihten önce üretilmiş oturum token'ları geçersizdir
  passwordChangedAt DateTime?
  termsAcceptedAt  DateTime?
  emailVerifiedAt  DateTime?
  // TOTP gizli anahtarı (AES-256-GCM ile şifreli); null ise 2FA kapalı
  twoFactorSecret  String?
  twoFactorEnabledAt DateTime?
  // Son kabul edilen TOTP zaman adımı; aynı veya daha eski kod tekrar kullanılamaz
  twoFactorLastStep Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders           Order[]          @relation("BuyerOrders")
  sellerOrders     Order[]          @relation("SellerOrders")
  walletTransactions WalletTransaction[]
  digitalPins      DigitalPin[]
  cartItems        CartItem[]
  reviews          Review[]
  sellingProducts  Product[]        @relation("UserSellingProducts")
  buyerDisputes    Dispute[]        @relation("BuyerDisputes")
  sellerDisputes   Dispute[]        @relation("SellerDisputes")
  sellerRequests   SellerRequest[]
  notifications    Notification[]
  store            Store?
  tickets          SupportTicket[]        @relation("UserTickets")
  ticketMessages   SupportTicketMessage[] @relation("TicketSender")
  conversations1   Conversation[]         @relation("User1Conversations")
  conversations2   Conversation[]         @relation("User2Conversations")
  sentMessages     DirectMessage[]        @relation("SentDirectMessages")
  withdrawalRequests WithdrawalRequest[]  @relation("UserWithdrawals")
  depositRequests  DepositRequest[]       @relation("UserDeposits")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  recoveryCodes    TwoFactorRecoveryCode[]
  payments         Payment[]
  auditLogs        AuditLog[]             @relation("AuditActor")
  broadcasts       NotificationBroadcast[]
  complaints       Complaint[]            @relation("ComplaintReporter")
  resolvedComplaints Complaint[]          @relation("ComplaintResolver")

  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String
  coverUrl    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model RolePermission {
  id         String   @id @default(uuid())
  role       Role
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@map("role_permissions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  imageUrl    String
  sortOrder   Int      @default(0)
  // Satış komisyonu (%); null ise PLATFORM_COMMISSION_PERCENT kullanılır
  commissionRate Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id              String                @id @default(uuid())
  title           String
  slug            String                @unique
  description     String
  shortDesc       String?
  categoryId      String
  imageUrl        String
  bannerUrl       String?
  galleryUrls     String[]              @default([])
  brand           String
  // Kodun etkinleştirilebileceği bölge kodu (GLOBAL, TR, EU...; bkz. product.constants REGIONS)
  region          String                @default("GLOBAL")
  instantDelivery Boolean               @default(true)
  deliveryType    DeliveryType          @default(INSTANT)
  deliveryDeadlineHours Int             @default(24)
  deliveryInstructions String?
  isFeatured      Boolean               @default(false)
  isPopular       Boolean               @default(false)
  isMarketplace   Boolean               @default(false)
  // Satıcı ilanı kapattığında false olur; listelenmez ve satın alınamaz
  isActive        Boolean               @default(true)
  // Satıcı ilanı geçici olarak yayından kaldırdığında false olur; kodlar ve stok korunur
  isListed        Boolean               @default(true)
  sellerId        String?
  approvalStatus  ProductApprovalStatus @default(APPROVED)
  approvedAt      DateTime?
  approvedById    String?
  rejectedReason  String?
  slaDeliverySeconds Float              @default(0.42)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  seller          User?            @relation("UserSellingProducts", fields: [sellerId], references: [id], onDelete: SetNull)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  reviews         Review[]
  conversations   Conversation[]   @relation("ConversationProduct")

  @@index([sellerId])
  @@index([categoryId])
  @@index([approvalStatus])
  @@map("products")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  orderId   String?
  rating    Int      @default(5)
  comment   String
  // Satıcının yoruma herkese açık yanıtı
  sellerReply     String?
  sellerRepliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model ProductVariant {
  id            String     @id @default(uuid())
  productId     String
  title         String
  denomination  String
  price         Decimal    @db.Decimal(12, 2)
  originalPrice Decimal?   @db.Decimal(12, 2)
  stockCount    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  pins          DigitalPin[]
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@map("product_variants")
}

model DigitalPin {
  id           String         @id @default(uuid())
  variantId    String
  code         String
  serialNumber String?
  status       PinStatus      @default(AVAILABLE)
  orderId      String?
  userId       String?
  soldAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, status])
  @@index([userId])
  @@index([orderId])
  @@map("digital_pins")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String
  // null => platform (admin) ürünleri; dolu => P2P satıcı siparişi
  sellerId      String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(WALLET)
  status        OrderStatus   @default(COMPLETED)
  deliveryType  DeliveryType  @default(INSTANT)
  deliveryStatus DeliveryStatus @default(DELIVERED)
  deliveredAt   DateTime?
  deliveryDeadlineAt DateTime?
  deliveryNotes String?
  escrowStatus  EscrowStatus  @default(HELD_IN_ESCROW)
  escrowAmount  Decimal?      @db.Decimal(12, 2)
  // Satış anında hesaplanan platform komisyonu; satıcıya escrowAmount - commissionAmount aktarılır
  commissionAmount Decimal    @default(0) @db.Decimal(12, 2)
  autoReleaseAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Cascade)
  seller        User?         @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  pins          DigitalPin[]
  dispute       Dispute?
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([sellerId])
  @@index([escrowStatus, deliveryStatus, autoReleaseAt])
  @@index([createdAt])
  @@map("orders")
}

model Dispute {
  id                String        @id @default(uuid())
  orderId           String        @unique
  buyerId           String
  // null => platform siparişi, doğrudan destek ekibine düşer
  sellerId          String?
  reason            DisputeReason
  description       String
  videoUrl          String
  status            DisputeStatus @default(WAITING_SELLER)
  sellerResponse    String?
  sellerAction      String?
  sellerActionAt    DateTime?
  replacementCode   String?
  resolvedByAdminId String?
  adminNotes        String?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer             User          @relation("BuyerDisputes", fields: [buyerId], references: [id], onDelete: Cascade)
  seller            User?         @relation("SellerDisputes", fields: [sellerId], references: [id], onDelete: SetNull)

  @@map("disputes")
}

model OrderItem {
  id         String         @id @default(uuid())
  orderId    String
  variantId  String
  quantity   Int            @default(1)
  unitPrice  Decimal        @db.Decimal(12, 2)
  totalPrice Decimal        @db.Decimal(12, 2)

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model CartItem {
  id        String         @id @default(uuid())
  userId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("cart_items")
}

model SellerRequest {
  id         String              @id @default(uuid())
  userId     String
  reason     String
  status     SellerRequestStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_requests")
}

model SupportTicket {
  id           String                 @id @default(uuid())
  ticketNumber String                 @unique
  userId       String
  subject      String
  category     String
  priority     TicketPriority         @default(MEDIUM)
  status       TicketStatus           @default(OPEN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user         User                   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  messages     SupportTicketMessage[]

  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String        @id @default(uuid())
  ticketId     String
  senderId     String
  message      String
  isAdminReply Boolean       @default(false)
  createdAt    DateTime      @default(now())

  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User          @relation("TicketSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("support_ticket_messages")
}

model Conversation {
  id            String          @id @default(uuid())
  user1Id       String
  user2Id       String
  productId     String?
  lastMessage   String?
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user1         User            @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User            @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)
  product       Product?        @relation("ConversationProduct", fields: [productId], references: [id], onDelete: SetNull)
  messages      DirectMessage[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

model WalletTransaction {
  id          String                @id @default(uuid())
  userId      String
  type        WalletTransactionType
  // Pozitif: bakiyeye giriş, negatif: bakiyeden çıkış
  amount      Decimal               @db.Decimal(12, 2)
  orderId     String?
  description String
  createdAt   DateTime              @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id            String           @id @default(uuid())
  userId        String
  // Talep açıldığında bakiyeden bloke edilir; red/iptalde iade edilir
  amount        Decimal          @db.Decimal(12, 2)
  // Talep anındaki para çekme komisyonu; kullanıcıya amount - fee gönderilir
  fee           Decimal          @default(0) @db.Decimal(12, 2)
  iban          String
  accountHolder String
  status        WithdrawalStatus @default(PENDING)
  adminNote     String?
  // Banka transfer referansı (ödendi işaretlenirken)
  transferRef   String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

model DepositRequest {
  id            String        @id @default(uuid())
  userId        String
  method        PaymentMethod @default(HAVALE_EFT)
  amount        Decimal       @db.Decimal(12, 2)
  // Onayda bankaya gerçekte ulaşan tutar
  approvedAmount Decimal?     @db.Decimal(12, 2)
  // Havale/EFT'de gönderen hesap sahibi; kripto yüklemede boş
  senderName    String?
  // Kripto yükleme: ağ (ör. USDT · TRC20) ve işlem özeti (aynı işlem iki kez bildirilemez)
  network       String?
  txHash        String?       @unique
  // Kullanıcının havale açıklamasına yazdığı benzersiz kod
  referenceCode String        @unique
  status        DepositStatus @default(PENDING)
  adminNote     String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation("UserDeposits", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("deposit_requests")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  // Token'ın SHA-256 özeti; ham token yalnızca e-postada bulunur
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  // Token'ın SHA-256 özeti; ham token yalnızca e-postada bulunur
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// 2FA kurtarma kodları (tek kullanımlık, SHA-256 özeti saklanır)
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("two_factor_recovery_codes")
}

/// Ödeme sağlayıcısı ayarları; gizli anahtarlar şifreli saklanır ve API'den dönmez
model PaymentGateway {
  provider    PaymentProvider @id
  isEnabled   Boolean         @default(false)
  testMode    Boolean         @default(true)
  displayName String
  description String?
  sortOrder   Int             @default(0)
  minAmount   Decimal         @default(20) @db.Decimal(12, 2)
  maxAmount   Decimal         @default(50000) @db.Decimal(12, 2)
  // Kullanıcıya yansıtılan hizmet bedeli: tutar × yüzde + sabit
  feePercent  Decimal         @default(0) @db.Decimal(5, 2)
  feeFixed    Decimal         @default(0) @db.Decimal(12, 2)
  // Gizli olmayan ayarlar (mağaza no, banka / cüzdan bilgileri)
  settings    Json            @default("{}")
  // AES-256-GCM ile şifrelenmiş gizli anahtarlar (JSON)
  secrets     String?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("payment_gateways")
}

/// Online ödeme sağlayıcısıyla yapılan bakiye yüklemesi
model Payment {
  id            String          @id @default(uuid())
  userId        String
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  // Cüzdana yüklenecek tutar
  amount        Decimal         @db.Decimal(12, 2)
  fee           Decimal         @default(0) @db.Decimal(12, 2)
  // Kullanıcıdan tahsil edilen toplam (amount + fee)
  chargeAmount  Decimal         @db.Decimal(12, 2)
  currency      String          @default("TRY")
  // Sağlayıcıdaki kayıt (Stripe session, PayTR merchant_oid, iyzico token, NOWPayments invoice)
  providerRef   String?
  checkoutUrl   String?
  failureReason String?
  testMode      Boolean         @default(false)
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Yönetim işlemleri geçmişi (kim, neyi, ne zaman)
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Kullanıcıların ilan, mağaza veya yorum şikâyetleri
model Complaint {
  id             String          @id @default(uuid())
  reporterId     String
  targetType     ComplaintTarget
  targetId       String
  reason         String
  details        String?
  status         ComplaintStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  reporter       User            @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     User?           @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, targetType, targetId])
  @@map("complaints")
}

/// Panelden yönetilen sistem ayarları (komisyon, SMTP...); gizli alanlar değer içinde şifreli tutulur
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

/// Yönetimden gönderilen toplu bildirimlerin geçmişi
model NotificationBroadcast {
  id             String   @id @default(uuid())
  title          String
  message        String
  link           String?
  // ALL, SELLERS, BUYERS, STAFF, USER
  audience       String
  recipientCount Int
  sendEmail      Boolean  @default(false)
  emailCount     Int      @default(0)
  sentById       String?
  createdAt      DateTime @default(now())

  sentBy         User?    @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("notification_broadcasts")
}
