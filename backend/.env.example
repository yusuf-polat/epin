PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nexuspin?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:5000

# Cookie (auto: production ortaminda Secure)
COOKIE_SECURE=auto
# COOKIE_DOMAIN=.example.com

# Test ortamında ödeme almadan doğrudan bakiye yükleme (varsayılan: development'ta açık, canlıda kapatın)
# ENABLE_WALLET_TOPUP=false
ESCROW_AUTO_RELEASE_HOURS=48

# Seed (yalnizca kullanici yoksa olusturulur)
SEED_ADMIN_EMAIL=admin@nexuspin.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_DESTEK_EMAIL=destek@nexuspin.com
SEED_DESTEK_PASSWORD=Destek123!

# Google OAuth (yalnizca Client ID gerekir; token Google sunucularinda dogrulanir)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend adresi (e-postadaki şifre sıfırlama bağlantıları için; boşsa CORS_ORIGIN'in ilki)
# FRONTEND_URL=http://localhost:3000

# Platform satış komisyonu (%); kategori bazında panelden ezilebilir
PLATFORM_COMMISSION_PERCENT=8

# Havale/EFT ile bakiye yükleme: platformun banka hesabı (IBAN boşsa özellik kapalıdır)
PLATFORM_BANK_NAME=Örnek Bank A.Ş.
PLATFORM_BANK_HOLDER=NexusPin Bilişim A.Ş.
PLATFORM_BANK_IBAN=TR330006100519786457841326

# E-posta (SMTP_HOST boşsa e-postalar gönderilmez, içerik log'a yazılır)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="NexusPin <no-reply@nexuspin.com>"
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48

# Ödeme sağlayıcılarının webhook/callback için ulaşacağı herkese açık backend adresi (boşsa APP_URL)
# PUBLIC_API_URL=https://api.example.com
# Ödeme ve 2FA anahtarlarını şifreleyen anahtar (boşsa JWT_SECRET'tan türetilir; en az 32 karakter)
# DATA_ENCRYPTION_KEY=change-me-another-long-random-secret-32-chars
