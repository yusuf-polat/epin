# docker compose bu dosyayı ".env" adıyla okur:  cp .env.example .env
# Canlı ortamda tüm şifreleri ve gizli anahtarları mutlaka değiştirin.

# ─── Veritabanı / Redis ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=nexuspin
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
NODE_ENV=production
# En az 32 karakter, rastgele:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:5000
COOKIE_SECURE=auto
# COOKIE_DOMAIN=.example.com
ENABLE_WALLET_TOPUP=false
ESCROW_AUTO_RELEASE_HOURS=48

# Ödeme sağlayıcılarının webhook/callback için ulaşacağı herkese açık (HTTPS) backend adresi
# PUBLIC_API_URL=https://api.example.com
# E-postadaki bağlantılar için frontend adresi
# FRONTEND_URL=https://example.com
# Ödeme API anahtarlarını ve 2FA anahtarlarını şifreler (en az 32 karakter). Sonradan değişirse anahtarlar panelden yeniden girilmelidir.
# DATA_ENCRYPTION_KEY=change-me-another-long-random-secret-32-chars

# Google ile giriş (isteğe bağlı)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
INTERNAL_API_URL=http://backend:5000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sitemap ve robots.txt için herkese açık site adresi
# SITE_URL=https://example.com
